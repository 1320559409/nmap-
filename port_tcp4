#!/bin/bash
# IPv4 TCP 端口扫描（手机热点优化：速率100~300包/秒）
cd "$(dirname "$0")"

if [ "$EUID" -ne 0 ]; then
    echo "错误: 需要 root 权限运行（nmap -sS）" >&2
    exit 1
fi

DATE=$(date +%Y%m%d)
OUT_DIR="$DATE"
mkdir -p "$OUT_DIR"

if [ ! -f ipv4 ]; then
    echo "错误: ipv4 文件不存在" >&2
    exit 1
fi

if [ ! -s ipv4 ]; then
    echo "错误: ipv4 文件为空" >&2
    exit 1
fi

if [ ! -f tports ]; then
    echo "错误: tports 文件不存在" >&2
    exit 1
fi

TCP_PORTS=$(awk '{print $1}' tports | grep -E '^[0-9]+$' | tr '\n' ',' | sed 's/,$//')
if [ -z "$TCP_PORTS" ]; then
    echo "错误: tports 中没有有效端口号" >&2
    exit 1
fi

TOTAL_IPS=$(wc -l < ipv4 | tr -d ' ')
PORT_COUNT=$(echo "$TCP_PORTS" | tr ',' '\n' | wc -l)

echo "========================================="
echo "IPv4 TCP 端口扫描"
echo "目标 IP 数: $TOTAL_IPS"
echo "端口数: $PORT_COUNT"
echo "参数: 速率 100~300包/秒, 重试3, 无主机超时"
echo "========================================="

nmap -sS -Pn -n -v --stats-every 10s --randomize-hosts \
     --min-rate 100 --max-rate 300 \
     --max-retries 3 \
     --min-rtt-timeout 200ms --max-rtt-timeout 4000ms \
     -p "$TCP_PORTS" -iL ipv4 -oG "$OUT_DIR/ipv4_tcp.gnmap" --open

echo "完成: $OUT_DIR/ipv4_tcp.gnmap"
