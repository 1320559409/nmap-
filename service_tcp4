#!/bin/bash
set -e
# IPv4 TCP 服务探测（按IP并行，并发3，限速100，带进度，自动清理临时目录）
cd "$(dirname "$0")"

DATE=${SCAN_DATE:-$(date +%Y%m%d)}
OUT_DIR="$DATE"
GNMAP="$OUT_DIR/ipv4_tcp.gnmap"

if [ ! -f "$GNMAP" ]; then
    echo "错误: $GNMAP 不存在，请先运行 port_tcp4" >&2
    exit 1
fi

OUTFILE="$OUT_DIR/service_ipv4_tcp"
TMPDIR="$OUT_DIR/tmp_ipv4_$$"
mkdir -p "$TMPDIR"

trap 'rm -rf "$TMPDIR"' EXIT INT TERM

> "$OUTFILE"

# 解析 gnmap，按 IP 分组端口
declare -A IP_PORTS
while IFS= read -r line; do
    if [[ "$line" =~ ^Host:[[:space:]]+([0-9.]+)[[:space:]]*(\(\))?[[:space:]]+Ports:[[:space:]]*(.*) ]]; then
        ip="${BASH_REMATCH[1]}"
        ports_part="${BASH_REMATCH[3]}"
        while [[ "$ports_part" =~ ([0-9]+)/open/tcp ]]; do
            port="${BASH_REMATCH[1]}"
            if [[ -z "${IP_PORTS[$ip]}" ]]; then
                IP_PORTS[$ip]="$port"
            else
                IP_PORTS[$ip]="${IP_PORTS[$ip]},$port"
            fi
            ports_part="${ports_part#*/open/tcp}"
        done
    fi
done < "$GNMAP"

if [ ${#IP_PORTS[@]} -eq 0 ]; then
    echo "未发现任何开放 TCP 端口，输出空文件" >&2
    exit 0
fi

TOTAL=${#IP_PORTS[@]}
echo "开始 IPv4 TCP 服务探测，共 $TOTAL 个 IP，并行度 3，每个 nmap 限速 100 包/秒" >&2

# 创建任务列表和计数器
TASK_LIST="$TMPDIR/tasks"
> "$TASK_LIST"
for ip in "${!IP_PORTS[@]}"; do
    echo "$ip ${IP_PORTS[$ip]}" >> "$TASK_LIST"
done

COUNTER_FILE="$TMPDIR/counter"
echo "0" > "$COUNTER_FILE"

export TMPDIR TOTAL COUNTER_FILE

# 按 IP 并行执行
cat "$TASK_LIST" | xargs -P 3 -I {} bash -c '
    ip=$(echo {} | cut -d" " -f1)
    ports=$(echo {} | cut -d" " -f2)
    safe_ip=$(echo "$ip" | tr "." "_")
    timestamp=$(date +%s%N)
    tmpout="$TMPDIR/out_${timestamp}_${safe_ip}"

    nmap -sV -v --version-intensity 2 -Pn -n \
         --min-rate 50 --max-rate 100 \
         --host-timeout 120s --max-retries 2 \
         --stats-every 5s \
         -p "$ports" "$ip" -oG - | \
    awk -v ip="$ip" '\''
        /^Host:/ {
            if (match($0, /Ports: /)) {
                rest = substr($0, RSTART+7)
                split(rest, entries, ",")
                for (i in entries) {
                    if (match(entries[i], /\/open\/tcp/)) {
                        split(entries[i], parts, "/")
                        port_num = parts[1]
                        service = parts[4]
                        if (service == "" || service == "?") service = "unknown"
                        gsub(/\?/, "", service)
                        printf "%s\t%s\t%s\t%s\t%s\n", ip, port_num, "tcp", "open", service
                    }
                }
            }
        }
    '\'' > "$tmpout"

    (
        flock -x 200
        count=$(cat "$COUNTER_FILE")
        count=$((count + 1))
        echo "$count" > "$COUNTER_FILE"
        echo "[$count/$TOTAL] 完成 $ip" >&2
    ) 200>> "$COUNTER_FILE"
'

cat "$TMPDIR"/out_* 2>/dev/null | sort -u > "$OUTFILE"
echo "完成: $OUTFILE (共 $(wc -l < "$OUTFILE") 条)" >&2
