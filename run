#!/bin/bash
set -e
cd "$(dirname "$0")"

# 固定扫描日期，避免跨天运行时目录不一致
export SCAN_DATE=$(date +%Y%m%d)
echo "扫描任务日期: $SCAN_DATE"

reset_network() {
    echo "    [INFO] Resetting network interface..." >&2
    nmcli device disconnect eth0 2>/dev/null || true
    sleep 2
    nmcli device connect eth0 2>/dev/null || true
    sleep 8

    if ip -4 addr show eth0 | grep -q 'inet '; then
        echo "    [OK] Network reset successful: $(ip -4 addr show eth0 | grep 'inet ' | awk '{print $2}')" >&2
        return 0
    else
        echo "    [WARN] IPv4 not ready, restarting NetworkManager..." >&2
        systemctl restart NetworkManager 2>/dev/null || true
        sleep 12

        if ip -4 addr show eth0 | grep -q 'inet '; then
            echo "    [OK] Network recovered: $(ip -4 addr show eth0 | grep 'inet ' | awk '{print $2}')" >&2
            return 0
        else
            echo "    [FATAL] Cannot recover IPv4!" >&2
            exit 1
        fi
    fi
}

echo "========== 1/8 TCP IPv4 端口扫描 =========="
reset_network
./port_tcp4

echo "========== 2/8 TCP IPv6 端口扫描 =========="
reset_network
./port_tcp6

echo "========== 3/8 TCP IPv4 服务探测 =========="
reset_network
./service_tcp4

echo "========== 4/8 TCP IPv6 服务探测 =========="
reset_network
./service_tcp6

echo "========== 5/8 UDP IPv4 端口扫描 =========="
reset_network
./port_udp4

echo "========== 6/8 UDP IPv6 端口扫描 =========="
reset_network
./port_udp6

echo "========== 7/8 UDP IPv4 服务探测 =========="
reset_network
./service_udp4

echo "========== 8/8 UDP IPv6 服务探测 =========="
reset_network
./service_udp6

echo "========== 合并所有结果 =========="
./process

echo "全部完成！最终结果: $SCAN_DATE/service_all"



